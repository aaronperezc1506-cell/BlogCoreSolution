<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Suportsaaron</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogCore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark store-nav">
        <div class="container">
            <a class="navbar-brand store-brand" asp-area="Cliente" asp-controller="Home" asp-action="Index"><i class="bi bi-cpu-fill"></i> SUPORT<span>SAARON</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-area="Cliente" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Cliente" asp-controller="Home" asp-action="ResultadoBusqueda" asp-route-searchString="celular">Celulares</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Cliente" asp-controller="Home" asp-action="ResultadoBusqueda" asp-route-searchString="computadora">Computadoras</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Cliente" asp-controller="Home" asp-action="ResultadoBusqueda" asp-route-searchString="audio">Audio</a></li>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Administración</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Articulos" asp-action="Index">Artículos</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Sliders" asp-action="Index">Sliders</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <form class="d-flex me-lg-3 my-2 my-lg-0" asp-area="Cliente" asp-controller="Home" asp-action="ResultadoBusqueda" method="get">
                    <input class="form-control form-control-sm" name="searchString" placeholder="Buscar productos..." />
                    <button class="btn btn-search ms-2" type="submit"><i class="bi bi-search"></i></button>
                </form>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
    @if (ViewBag.IsHome == true)
    {
        <partial name="_Slider" model="@(ViewBag.Sliders as IEnumerable<BlogCoreSolution.Models.Slider>)" />
    }
</header>
<div class="container page-shell"><main role="main" class="pb-4">@RenderBody()</main></div>
<footer class="store-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <a class="store-brand" asp-area="Cliente" asp-controller="Home" asp-action="Index"><i class="bi bi-cpu-fill"></i> SUPORT<span>SAARON</span></a>
        <span>© @DateTime.Now.Year Derechos reservados.</span>
        <span>Desarrollado por <strong>Aaron Perez 11 06</strong></span>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- Dependencias requeridas por las tablas administrativas y sus mensajes. -->
<script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
